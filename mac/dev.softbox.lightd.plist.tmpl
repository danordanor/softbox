<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>dev.softbox.lightd</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PYTHON__</string>
    <string>__DIR__/lightd.py</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>LIGHTD_HOME</key><string>__HOME__</string>
    <key>LIGHTD_WEB</key><string>__WEB__</string>
    <key>LIGHTD_PORT</key><string>__PORT__</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>5</integer>
  <key>StandardOutPath</key><string>__HOME__/lightd.log</string>
  <key>StandardErrorPath</key><string>__HOME__/lightd.log</string>
</dict>
</plist>
